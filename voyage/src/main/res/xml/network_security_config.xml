<?xml version="1.0" encoding="utf-8"?>
<!-- Tout le trafic réseau doit être chiffré (HTTPS) ; seuls les certificats système sont acceptés. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
