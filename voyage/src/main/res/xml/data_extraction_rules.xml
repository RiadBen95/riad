<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : aucune donnée (clés d'API, voyages, réservations) n'est copiée dans les
     sauvegardes cloud ni lors d'un transfert vers un autre téléphone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
